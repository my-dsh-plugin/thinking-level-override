      "@deepseek-ai/schemastery": ["../deepseek-harness/vendor/schemastery/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-api-remotes/client": ["../deepseek-harness/packages/api/remotes/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-api-remotes/types": ["../deepseek-harness/packages/api/remotes/lib/types/types.d.ts"],
